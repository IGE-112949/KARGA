# Connection string do Postgres do Supabase (Project Settings > Database > Connection pooler, modo session)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# URL do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
# Chave service_role (só no servidor, nunca na app)
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000
# Chave pública (publishable) — só usada pelo script de teste e pela app
SUPABASE_PUBLISHABLE_KEY=sb_publishable__voVNlvZIR9p0jRP3jIvkA_vk_KY98_
